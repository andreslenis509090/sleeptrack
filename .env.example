# ==============================================================================
# SleepTrack Backend - Archivo de Ejemplo de Variables de Entorno
# ==============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo con el nombre `.env` en la raíz del proyecto:
#    cp .env.example .env   (Linux/macOS)
#    Copy-Item .env.example .env (PowerShell en Windows)
# 2. Reemplaza los valores de ejemplo por tus credenciales reales obtenidas de Supabase.
# 3. NUNCA compartas ni subas tu archivo `.env` a repositorios públicos ni chats.
# ==============================================================================

# URL base del proyecto Supabase (Project Settings -> API -> Project URL)
# Ejemplo: https://abcdefghijklm.supabase.co
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave API de Supabase (Project Settings -> API -> Project API keys)
# Puedes usar la clave 'anon' pública o 'service_role' privada (recomendada para backend seguro)
SUPABASE_KEY=tu-clave-supabase-aqui

# Entorno de ejecución: 'development', 'staging' o 'production'
ENVIRONMENT=development

# Prefijo global de rutas para la API REST (definido en RNF07)
API_PREFIX=/api/v1
